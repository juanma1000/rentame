# Copy this file to `.env` (repo root, for docker-compose) and to
# `backend/.env` (for the FastAPI app / Alembic / pytest) and adjust as needed.
# Never commit the real `.env` file.

# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=rentame
POSTGRES_PASSWORD=rentame
POSTGRES_DB=rentame
POSTGRES_PORT=5432

# --- MinIO (docker-compose) — S3-compatible object storage for local dev ---
MINIO_ROOT_USER=rentame
MINIO_ROOT_PASSWORD=rentame12345
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Backend app (shared/infrastructure/settings.py) ---
APP_NAME="Rentame API"
ENVIRONMENT=development

# Must match the POSTGRES_* values above when running against docker-compose.
DATABASE_URL=postgresql+asyncpg://rentame:rentame@localhost:5432/rentame
# Separate database used by the test suite (created automatically by
# docker/postgres/init-test-db.sh on first container start).
TEST_DATABASE_URL=postgresql+asyncpg://rentame:rentame@localhost:5432/rentame_test

# JWT — change the secret in every non-local environment.
JWT_SECRET_KEY=dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Object storage — must match the MINIO_* values above when running against docker-compose.
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY=rentame
STORAGE_SECRET_KEY=rentame12345
STORAGE_BUCKET_NAME=inmuebles
STORAGE_REGION=us-east-1

# Business rule configuration (inmuebles domain)
MAX_FOTOS_INMUEBLE=10
